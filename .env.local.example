# WhatsApp da equipe de vendas — formato internacional sem +, ex: 553195719123
NEXT_PUBLIC_WHATSAPP_NUMBER=553195719123

# WhatsApp do Julio (responsavel pela rede de representantes/contadores)
# Se vazio, cai no NEXT_PUBLIC_WHATSAPP_NUMBER acima
NEXT_PUBLIC_WHATSAPP_JULIO=553195719123

# CNPJ da empresa — exibido no footer e páginas institucionais
NEXT_PUBLIC_CNPJ=38.180.982/0001-13

# URL pública do site (usada em metadata, sitemap, OG)
NEXT_PUBLIC_SITE_URL=https://paguecomsplit.com.br

# Webhook que recebe leads via POST a partir de /api/lead
# Em dev, deixar vazio → fallback de log no console
LEAD_WEBHOOK_URL=

# Token opcional enviado como header X-Webhook-Token para o webhook
LEAD_WEBHOOK_TOKEN=

# Google Analytics 4 — id começa com G-
NEXT_PUBLIC_GA_ID=

# Meta Pixel — id numérico
NEXT_PUBLIC_META_PIXEL_ID=
